VITE_BACKEND_BASE_URL=http://127.0.0.1:8080
# Leave false for the existing Firebase project. Start-AdminWeb.ps1 sets true locally.
VITE_USE_FIREBASE_EMULATORS=false

# Business data is independent of emulator/cloud selection. No fallback on API errors.
VITE_ADMIN_DATA_SOURCE=mock
# Set firebase to call the 21 admin APIs (backend exports are required).
