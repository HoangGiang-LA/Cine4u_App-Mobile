{
  "rules": {
    ".read": false,
    ".write": false,
    "categories": {
      ".indexOn": ["status"],
      ".read": "auth != null && root.child('accountAccess').child(auth.uid).child('status').val() === 'active' && query.orderByChild === 'status' && query.equalTo === 'published'"
    },
    "topics": {
      ".indexOn": ["status", "categoryId"],
      ".read": "auth != null && root.child('accountAccess').child(auth.uid).child('status').val() === 'active' && query.orderByChild === 'status' && query.equalTo === 'published'"
    },
    "accountAccess": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "practiceAttempts": {
      "$uid": {
        ".indexOn": ["finishedAt"]
      }
    },
    "notifications": {
      "$uid": {
        ".indexOn": ["createdAt"]
      }
    },
    "coinLedger": {
      "$uid": {
        ".indexOn": ["createdAt"]
      }
    }
  }
}
